#!/usr/bin/env bash
#
# gsh - Prints detailed system info for engineering, low-latency and hardware development
#
# Copyright (c) 2015-2026, Augusto Damasceno.
# All rights reserved.
# SPDX-License-Identifier: GPL-3.0
#
# See https://github.com/augustodamasceno/gsh
#
# Usage: gsysinfos

BOLD='\033[1m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
RESET='\033[0m'

field() {
    printf "  ${BOLD}${YELLOW}%-22s${RESET}%s\n" "$1" "$2"
}

section() {
    local cols
    cols=$(tput cols 2>/dev/null || echo 60)
    local label=" $1 "
    local pad=$(( (cols - ${#label} - 2) / 2 ))
    local line
    line=$(printf '%*s' "$pad" '' | tr ' ' '─')
    printf "\n${CYAN}${BOLD}%s%s%s${RESET}\n" "$line" "$label" "$line"
}

section "SYSTEM"
field "OS:" "$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
field "Kernel:" "$(uname -r)"
field "Architecture:" "$(uname -m)"
field "Hostname:" "$(hostname -f 2>/dev/null || hostname)"
field "Uptime:" "$(uptime -p 2>/dev/null | sed 's/^up //')"

section "CPU"
field "Model:" "$(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | sed 's/^ *//')"
field "Sockets:" "$(lscpu | awk -F: '/^Socket\(s\)/{gsub(/ /,"",$2); print $2}')"
field "Cores per socket:" "$(lscpu | awk -F: '/Core\(s\) per socket/{gsub(/ /,"",$2); print $2}')"
field "Threads per core:" "$(lscpu | awk -F: '/Thread\(s\) per core/{gsub(/ /,"",$2); print $2}')"
field "Total threads:" "$(nproc)"
field "Max MHz:" "$(lscpu | awk -F: '/CPU max MHz/{gsub(/ /,"",$2); printf "%.0f\n", $2}' 2>/dev/null)"
lscpu | awk -F: '/cache/{gsub(/^ +/,"",$2); printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", $1":", $2}'

section "MEMORY"
free -h | awk '
    NR==1 { printf "  \033[1m  %-10s %8s %8s %8s %8s\033[0m\n", "Type", "Total", "Used", "Free", "Available" }
    NR==2 { printf "  \033[0;36m  %-10s\033[0m %8s %8s %8s %8s\n", "RAM",  $2, $3, $4, $7 }
    NR==3 { printf "  \033[0;36m  %-10s\033[0m %8s %8s %8s\n",     "Swap", $2, $3, $4 }'

section "DISK"
df -h | awk '
    NR==1 { printf "  \033[1m%-30s %8s %8s %8s %6s\033[0m\n", "Filesystem", "Size", "Used", "Avail", "Use%" }
    NR>1 && $NF !~ /^(\/dev|\/sys|\/proc|\/run|\/snap)/ {
        pct=$5+0
        color=(pct>=90)?"\033[0;31m":(pct>=70)?"\033[0;33m":"\033[0;32m"
        printf "  %s%-30s\033[0m %8s %8s %8s %6s\n", color, $NF, $2, $3, $4, $5
    }'

section "NETWORK"
if command -v ip &>/dev/null; then
    ip -o -4 addr show 2>/dev/null | awk '
        !/127\.0\.0\.1/ {
            split($4,a,"/")
            printf "  \033[0;36m%-16s\033[0m %s\n", $2, a[1]
        }'
fi

section "NUMA"
if command -v numactl &>/dev/null; then
    numactl --hardware 2>/dev/null | awk '
        /^node [0-9]+ cpus/   { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "Node "$2" CPUs:",   substr($0, index($0,$4)) }
        /^node [0-9]+ size/   { printf "  \033[1m\033[0;33m%-22s\033[0m%s MB\n", "Node "$2" Memory:", $4 }
        /^node distances/     { printf "  \033[1m\033[0;33m%-22s\033[0m\n", "Node distances:" }
        /^node [0-9]+:/ && !/size|cpus|free/ { printf "    %s\n", $0 }'
else
    numa_nodes=$(ls /sys/devices/system/node/ 2>/dev/null | grep -c '^node[0-9]')
    field "NUMA nodes:" "${numa_nodes:-1}"
    for node in /sys/devices/system/node/node*/; do
        n=$(basename "$node" | tr -d 'node')
        cpus=$(cat "$node/cpulist" 2>/dev/null)
        mem_kb=$(grep MemTotal "$node/meminfo" 2>/dev/null | awk '{print $4}')
        mem_mb=$(( ${mem_kb:-0} / 1024 ))
        field "  Node $n CPUs:" "$cpus"
        field "  Node $n Memory:" "${mem_mb} MB"
    done
fi

section "CPU TOPOLOGY"
field "Virtualization:" "$(lscpu | awk -F: '/Virtualization type/{gsub(/^ +/,"",$2); print $2}' 2>/dev/null)"
field "Hypervisor vendor:" "$(lscpu | awk -F: '/Hypervisor vendor/{gsub(/^ +/,"",$2); print $2}' 2>/dev/null)"
field "NUMA nodes:" "$(lscpu | awk -F: '/NUMA node\(s\)/{gsub(/ /,"",$2); print $2}')"
field "Stepping:" "$(lscpu | awk -F: '/Stepping/{gsub(/ /,"",$2); print $2}')"
field "BogoMIPS:" "$(grep -m1 'bogomips' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')"
field "Byte order:" "$(lscpu | awk -F: '/Byte Order/{gsub(/^ +/,"",$2); print $2}')"
flags=$(grep -m1 '^flags' /proc/cpuinfo | cut -d: -f2)
for flag in avx avx2 avx512f sse4_2 aes rdrand rdseed tsc_reliable constant_tsc nonstop_tsc rdtscp; do
    echo "$flags" | grep -qw "$flag" && found+="$flag "
done
field "Key CPU flags:" "${found:-none detected}"
unset found

section "KERNEL & REAL-TIME"
field "Kernel version:" "$(uname -r)"
field "Kernel build:" "$(uname -v | cut -c1-60)"
field "Preemption model:" "$(uname -r | grep -oE '(PREEMPT_RT|PREEMPT|voluntary)' || \
    zcat /proc/config.gz 2>/dev/null | grep 'CONFIG_PREEMPT=' | cut -d= -f2 || echo 'unknown')"
field "HZ (timer freq):" "$(zcat /proc/config.gz 2>/dev/null | grep '^CONFIG_HZ=' | cut -d= -f2 || \
    grep -r 'CONFIG_HZ' /boot/config-"$(uname -r)" 2>/dev/null | grep -v '#' | head -1 | cut -d= -f2 || echo 'unknown')"
field "Nohz mode:" "$(zcat /proc/config.gz 2>/dev/null | grep 'CONFIG_NO_HZ' | grep -v '^#' | \
    grep -oE '(FULL|IDLE|COMMON)' | head -1 || echo 'unknown')"
field "NMI watchdog:" "$(cat /proc/sys/kernel/nmi_watchdog 2>/dev/null)"
field "Hung task timeout:" "$(cat /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null) s"

section "SCHEDULER"
field "Sched latency ns:" "$(cat /proc/sys/kernel/sched_latency_ns 2>/dev/null)"
field "Sched min gran ns:" "$(cat /proc/sys/kernel/sched_min_granularity_ns 2>/dev/null)"
field "Sched wakeup ns:" "$(cat /proc/sys/kernel/sched_wakeup_granularity_ns 2>/dev/null)"
field "Sched migration:" "$(cat /proc/sys/kernel/sched_migration_cost_ns 2>/dev/null) ns"
gov_list=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null | sort -u | tr '\n' ' ')
field "CPU freq governor:" "${gov_list:-unavailable}"

section "MEMORY DETAILS"
field "Hugepages (2MB):" "$(grep -w HugePages_Total /proc/meminfo | awk '{print $2}') pages ($(grep Hugepagesize /proc/meminfo | awk '{print $2}') kB each)"
field "Hugepages free:" "$(grep -w HugePages_Free /proc/meminfo | awk '{print $2}')"
hp1g=$(grep 'pdp' /proc/cpuinfo | head -1 || grep -c 'pdpe1gb' /proc/cpuinfo/flags 2>/dev/null || echo '')
field "1GB pages support:" "$(grep -qw pdpe1gb /proc/cpuinfo && echo 'yes' || echo 'no')"
field "Transparent HP:" "$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null)"
field "NUMA balancing:" "$(cat /proc/sys/kernel/numa_balancing 2>/dev/null | awk '{print ($1==1)?"enabled":"disabled"}')"
field "Dirty ratio:" "$(cat /proc/sys/vm/dirty_ratio 2>/dev/null)%"
field "Dirty bg ratio:" "$(cat /proc/sys/vm/dirty_background_ratio 2>/dev/null)%"
field "Swappiness:" "$(cat /proc/sys/vm/swappiness 2>/dev/null)"
if command -v dmidecode &>/dev/null; then
    mem_speed=$(dmidecode -t memory 2>/dev/null | grep -m1 'Speed:' | grep -v 'Unknown' | awk '{print $2, $3}')
    mem_type=$(dmidecode -t memory 2>/dev/null | grep -m1 'Type:' | grep -v 'Unknown\|Error' | awk '{print $2}')
    field "RAM type / speed:" "${mem_type:-?} / ${mem_speed:-? (run as root)}"
fi

section "PCIe & DEVICES"
if command -v lspci &>/dev/null; then
    lspci 2>/dev/null | awk '
        /VGA|3D|Display/          { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "GPU:", substr($0, index($0,$2)) }
        /Ethernet/                { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "NIC:", substr($0, index($0,$2)) }
        /Non-Volatile|NVM|NVME/   { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "NVMe:", substr($0, index($0,$2)) }
        /InfiniBand|RDMA/         { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "RDMA/IB:", substr($0, index($0,$2)) }
        /FPGA|Xilinx|Altera/      { printf "  \033[1m\033[0;33m%-22s\033[0m%s\n", "FPGA:", substr($0, index($0,$2)) }'
else
    printf "  (lspci not available)\n"
fi

section "IRQ & CPU ISOLATION"
field "Isolated CPUs:" "$(cat /sys/devices/system/cpu/isolated 2>/dev/null || echo 'none')"
field "RCU nocbs CPUs:" "$(cat /sys/devices/system/cpu/rcu_nocbs 2>/dev/null || \
    grep -oE 'rcu_nocbs=[^ ]+' /proc/cmdline 2>/dev/null | cut -d= -f2 || echo 'none')"
field "IRQ affinity:" "$(cat /proc/irq/default_smp_affinity 2>/dev/null)"
irq_count=$(grep -c '^ *[0-9]' /proc/interrupts 2>/dev/null)
field "Active IRQs:" "$irq_count"

printf "  ${BOLD}${YELLOW}%-22s${RESET}\n" "Top IRQs:"
awk 'NR>1 {
    sum=0; for(i=2;i<=NF-2;i++) sum+=$i
    print sum, $NF
}' /proc/interrupts 2>/dev/null | sort -rn | head -5 | \
    awk '{printf "    \033[0;36m%10d\033[0m  %s\n", $1, $2}'

printf '\n'

