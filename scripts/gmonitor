#!/usr/bin/env bash
#
# gsh - Continuously prints system stats at a configurable interval
#
# Copyright (c) 2015-2026, Augusto Damasceno.
# All rights reserved.
# SPDX-License-Identifier: GPL-3.0
#
# See https://github.com/augustodamasceno/gsh
#
# Usage: gmonitor [INTERVAL_SECONDS]

# Colors
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

print_header() {
    local label="$1"
    local color="${2:-$CYAN}"
    local cols
    cols=$(tput cols)
    local pad=$(( (cols - ${#label} - 2) / 2 ))
    local line
    line=$(printf '%*s' "$pad" '' | tr ' ' '─')
    printf "${color}${BOLD}%s %s %s${RESET}\n" "$line" "$label" "$line"
}

print_field() {
    local label="$1"
    local value="$2"
    printf "  ${BOLD}${YELLOW}%-20s${RESET}%s\n" "$label" "$value"
}

timeSleep=${1:-3}
cpulines=$(( $(grep -c processor /proc/cpuinfo) + 2 ))

while true; do
    clear
    cols=$(tput cols)

    print_header "  GMONITOR  " "$RED"
    printf "  ${BOLD}${GREEN}%s${RESET}\n\n" "$(date '+%A, %B %-d %Y  %H:%M:%S')"

    print_header " USERS " "$CYAN"
    w --no-header 2>/dev/null | awk '{
        printf "  \033[0;36m%-12s\033[0m %-8s %-16s %s\n", $1, $2, $3, $8
    }'
    echo

    print_header " CPU " "$CYAN"
    if command -v mpstat &>/dev/null; then
        mpstat -P ALL 2>/dev/null | tail -n "$cpulines" | awk '
            NR==1 { printf "  \033[1m%-6s %6s %6s %6s %6s\033[0m\n", "CPU", "%usr", "%sys", "%iow", "%idle"; next }
            /^[0-9]|^all/ {
                idle=$NF+0
                color = (idle < 20) ? "\033[0;31m" : (idle < 60) ? "\033[0;33m" : "\033[0;32m"
                printf "  %s%-6s %6s %6s %6s %6s\033[0m\n", color, $3, $4, $6, $7, $NF
            }'
    else
        grep -m1 'cpu ' /proc/stat | awk '{
            total=$2+$3+$4+$5+$6+$7+$8
            used=total-$5
            pct=int(used*100/total)
            color=(pct>80)?"\033[0;31m":(pct>50)?"\033[0;33m":"\033[0;32m"
            printf "  %sCPU usage: %d%%\033[0m\n", color, pct
        }'
    fi
    echo

    print_header " MEMORY " "$CYAN"
    free -h | awk '
        NR==1 { printf "  \033[1m%-10s %8s %8s %8s\033[0m\n", "Type", "Total", "Used", "Free" }
        NR==2 {
            used=$3; total=$2
            printf "  \033[0;36m%-10s\033[0m %8s %8s %8s\n", "RAM", $2, $3, $4
        }
        NR==3 { printf "  \033[0;36m%-10s\033[0m %8s %8s %8s\n", "Swap", $2, $3, $4 }'
    echo

    print_header " TOP CPU PROCESSES " "$CYAN"
    ps aux --sort=-%cpu | awk '
        NR==1 { printf "  \033[1m%-20s %6s %5s %5s\033[0m\n", "COMMAND", "PID", "%CPU", "%MEM" }
        NR>1 && NR<=4 {
            cmd=substr($11,1,20)
            color=(NR==2)?"\033[0;31m":(NR==3)?"\033[0;33m":"\033[0;32m"
            printf "  %s%-20s\033[0m %6s %5s %5s\n", color, cmd, $2, $3, $4
        }'
    echo

    print_header " TOP MEMORY PROCESSES " "$CYAN"
    ps aux --sort=-%mem | awk '
        NR==1 { printf "  \033[1m%-20s %6s %5s %5s\033[0m\n", "COMMAND", "PID", "%CPU", "%MEM" }
        NR>1 && NR<=4 {
            cmd=substr($11,1,20)
            color=(NR==2)?"\033[0;31m":(NR==3)?"\033[0;33m":"\033[0;32m"
            printf "  %s%-20s\033[0m %6s %5s %5s\n", color, cmd, $2, $3, $4
        }'
    echo

    print_header "  next refresh in ${timeSleep}s  " "$RED"
    sleep "$timeSleep"
done

